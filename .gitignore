config/hermes/.env
config/hermes/sessions/
config/hermes/logs/
config/hermes/memories/
config/hermes/profiles/
config/hermes/skills/
config/hermes/cron/
config/hermes/todos/
# plugin-data/ — персистентный стейт плагинов (path-guard пишет сюда events.jsonl);
# лог решений раунда 3 хранится вне git, копируется вручную при документировании прогона
config/hermes/plugin-data/
