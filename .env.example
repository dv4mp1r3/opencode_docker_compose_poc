# Модель которую будет использовать OpenCode
# Варианты: qwen2.5-coder:7b, qwen2.5-coder:14b, deepseek-coder-v2:16b, codestral:22b
OPENCODE_MODEL=qwen2.5-coder:7b

# Путь к проекту который монтируется в контейнер OpenCode
# Можно указать абсолютный путь: /Users/username/myproject
WORKSPACE_PATH=./workspace

# Порт Ollama на хосте
OLLAMA_PORT=11434

# Хост Ollama внутри docker-сети, который использует OpenCode (OPENCODE_BASE_URL).
# По умолчанию — сервис ollama из этого compose. Если Ollama крутится на хосте
# (см. OLLAMA_MACOS.md) — укажи host.docker.internal, либо адрес/хост внешнего Ollama.
OLLAMA_HOST=ollama

# ── Hermes Agent + llama.cpp (hermes-llamacpp.yml / hermes-llamacpp.gpu.yml) ────────

# HuggingFace repo:quant для авто-докачки GGUF при первом старте llama-server
# (флаг -hf / env LLAMA_ARG_HF_REPO). Дефолт — лёгкая модель для смок-теста CPU/Mac,
# НЕ кандидат для содержательной оценки — см. память project_fourth_experiment_hermes_llamacpp_setup
# про выбор реального кандидата (Devstral не в нативном списке tool-call форматов llama.cpp).
LLAMACPP_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct-GGUF:Q4_K_M

# Контекст модели (LLAMA_ARG_CTX_SIZE)
LLAMACPP_CTX=65536

# Порт llama.cpp server на хосте (проброс порта контейнера наружу)
LLAMACPP_PORT=8080

# Базовый URL, по которому Hermes ходит к llama-server (providers.local-llamacpp.api
# в config/hermes/config.yaml). Дефолт — имя сервиса в docker-сети этого compose.
# Если llama-server крутится БЕЗ Docker на внешнем GPU-хосте — переопределить на
# http://<IP-хоста>:<порт>/v1 (порт — тот, что реально слушает бинарник, не обязательно
# совпадает с LLAMACPP_PORT выше).
LLAMACPP_BASE_URL=http://llama-cpp:8080/v1

# UID:GID, под которым идёт процесс llama-server внутри контейнера (образ по
# умолчанию root — принудительно понижаем; volume с кэшем моделей chown'ится под
# этот же UID/GID сервисом llamacpp-init).
LLAMACPP_UID=1000
LLAMACPP_GID=1000

# Кол-во слоёв офлоада на GPU (LLAMA_ARG_N_GPU_LAYERS) — применяется только с
# hermes-llamacpp.gpu.yml
LLAMACPP_NGL=99

# Токен HuggingFace, если модель приватная/лимитируется (обычно не нужен для публичных GGUF)
HF_TOKEN=

# Зеркало HuggingFace для докачки GGUF — llama.cpp уважает HF_ENDPOINT как базовый URL
# вместо https://huggingface.co/ (подтверждено в common/common.cpp, ggml-org/llama.cpp).
# Пусто по умолчанию. Заполнить, например, https://hf-mirror.com/ (со слэшем на конце),
# если докачка падает с `curl: (35) TLS connect error` на CDN-редиректе HF (у одного из
# внешних GPU-хостов эксперимента 4 так и было — сам huggingface.co отвечал, а
# CloudFront-редирект рвался на TLS-хендшейке).
HF_ENDPOINT=

# Прокси для контейнеров llama-cpp и hermes на этом стеке — на Linux-хосте вместе с
# extra_hosts: host.docker.internal:host-gateway (уже прописан в hermes-llamacpp.yml)
# позволяет достучаться до SOCKS/HTTP-прокси, слушающего на самом хосте (ssh -D,
# shadowsocks/v2ray и т.п.). Подтверждено (2026-09-09, реальный внешний GPU-хост,
# блокировка на уровне провайдера): даунлоадер llama.cpp — голый libcurl без своей
# прокси-логики, значит эти переменные подхватываются автоматически, включая SOCKS через
# схему socks5h:// (h — DNS тоже через прокси, не только IP-трафик).
#
# Прокси-клиент должен слушать НЕ только на 127.0.0.1 хоста (иначе host-gateway до него
# не достучится) — либо перебиндить на 0.0.0.0, либо явно на IP docker-бриджа.
#
# Пример (порт/адрес — свои):
# HTTP_PROXY=socks5h://host.docker.internal:1080
# HTTPS_PROXY=socks5h://host.docker.internal:1080
# ALL_PROXY=socks5h://host.docker.internal:1080
