# Модель которую будет использовать OpenCode
# Варианты: qwen2.5-coder:7b, qwen2.5-coder:14b, deepseek-coder-v2:16b, codestral:22b
OPENCODE_MODEL=qwen2.5-coder:7b

# Путь к проекту который монтируется в контейнер OpenCode
# Можно указать абсолютный путь: /Users/username/myproject
WORKSPACE_PATH=./workspace

# Порт Ollama на хосте
OLLAMA_PORT=11434

# Хост Ollama внутри docker-сети, который использует OpenCode (OPENCODE_BASE_URL).
# По умолчанию — сервис ollama из этого compose. Если Ollama крутится на хосте
# (см. OLLAMA_MACOS.md) — укажи host.docker.internal, либо адрес/хост внешнего Ollama.
OLLAMA_HOST=ollama

# ── Hermes Agent + llama.cpp (hermes-llamacpp.yml / hermes-llamacpp.gpu.yml) ────────

# HuggingFace repo:quant для авто-докачки GGUF при первом старте llama-server
# (флаг -hf / env LLAMA_ARG_HF_REPO). Дефолт — лёгкая модель для смок-теста CPU/Mac,
# НЕ кандидат для содержательной оценки — см. память project_fourth_experiment_hermes_llamacpp_setup
# про выбор реального кандидата (Devstral не в нативном списке tool-call форматов llama.cpp).
LLAMACPP_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct-GGUF:Q4_K_M

# Контекст модели (LLAMA_ARG_CTX_SIZE)
LLAMACPP_CTX=65536

# Порт llama.cpp server на хосте
LLAMACPP_PORT=8080

# UID:GID, под которым идёт процесс llama-server внутри контейнера (образ по
# умолчанию root — принудительно понижаем; volume с кэшем моделей chown'ится под
# этот же UID/GID сервисом llamacpp-init).
LLAMACPP_UID=1000
LLAMACPP_GID=1000

# Кол-во слоёв офлоада на GPU (LLAMA_ARG_N_GPU_LAYERS) — применяется только с
# hermes-llamacpp.gpu.yml
LLAMACPP_NGL=99

# Токен HuggingFace, если модель приватная/лимитируется (обычно не нужен для публичных GGUF)
HF_TOKEN=
