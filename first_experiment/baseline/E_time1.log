 httplib::Server svr;
 
 svr.Get("/", [&](const httplib::Request& req, httplib::Response& res) {
+// Handle /hello?name=... route
+if (req.path.rfind("/hello", 0) == 0) {
+    std::string name = "world";
+    size_t queryPos = req.path.find('?');
+    if (queryPos != std::string::npos) {
+        std::string query = req.path.substr(queryPos + 1);
+        // Simple key=value parsing loop
+        size_t pos = 0;
+        while (pos < query.size()) {
+            size_t eq = query.find('=', pos);
+            if (eq == std::string::npos) break;
+            std::string key = query.substr(pos, eq - pos);
+            size_t amp = query.find('&', eq + 1);
+            std::string val = query.substr(eq + 1, (amp == std::string::npos ? query.size() : amp) - eq - 1);
+            if (key == "name") {
+                name = val;
+                break; // assume only one param
+            }
+            pos = (amp == std::string::npos) ? query.size() : amp + 1;
+        }
+    }
+    res.set_content("Hello "+name, "text/plain");
+    return; // skip default handling
+}
