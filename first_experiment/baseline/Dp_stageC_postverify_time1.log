++            self.rnfr_target = None
++            self.send_reply("550 Requested file action not taken; file unavailable.\r\n")
++            return
++        try:
++            os.rename(self.rnfr_target, dst)
++        except OSError:
++            self.rnfr_target = None
++            self.send_reply("550 Requested file action not taken; file unavailable.\r\n")
++            return
++        # success
++        self.rnfr_target = None
++        self.send_reply("250 Requested file action performed successfully.\r\n")
