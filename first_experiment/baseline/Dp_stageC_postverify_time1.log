++        # Внутри корня и существующий
++        if not target or not os.path.exists(target):
++            self.rnfr_target = None
++            self.send_reply("550 Requested file action not taken; file unavailable.\r\n")
++            return
++        self.rnfr_target = target
++        self.send_reply("350 Requested file action pending;\r\n")
++
++    def do_RNTO(self, arg: str):
++        """
++        Finalize rename.  Переименовывает сохранённый файл в указанный путь.
++        Возвращает 250 при успехе, 503 если не был сделан RNFR, 550 иначе.
++        """
++        if not self.logged_in:
++            self.send_reply(REPLY_530)
++            return
