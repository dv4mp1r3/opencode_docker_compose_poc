 svr.Get("/", [&](const httplib::Request& req, httplib::Response& res) {
     // Resolve file path relative to root directory
+    if (req.path.rfind("/hello", 0) == 0) {
+        const std::string prefix = "/hello";
+        std::string name = "Stranger";
+        auto pos = req.path.find('?', prefix.size());
+        if (pos != std::string::npos && pos + 1 < req.path.size()) {
+            std::string query = req.path.substr(pos + 1);
+            size_t start = 0;
+            while (start < query.size()) {
+                size_t end = query.find('&', start);
+                std::string pair = query.substr(start, end == std::string::npos ? std::string::npos : end - start);
+                size_t eq = pair.find('=');
+                if (eq != std::string::npos) {
+                    std::string k = pair.substr(0, eq);
+                    std::string v = pair.substr(eq + 1);
+                    if (k == "name") {
+                        name = v;
+                        break;
+                    }
+                }
+                if (end == std::string::npos)
+                    break;
+                start = end + 1;
+            }
+        }
+        res.set_content("Hello, " + name + "!", "text/plain");
+        res.status = 200;
+        return;
+    }
     std::filesystem::path p = root.empty() ? std::filesystem::current_path() : std::filesystem::path(root);
