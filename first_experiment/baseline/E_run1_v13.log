```cpp
if (req.path.find("/hello") == 0) {
    std::string name = "Guest";
    size_t qpos = req.path.find('?');
    if (qpos != std::string::npos) {
        std::string qs = req.path.substr(qpos + 1);
        auto eq = qs.find('=');
        if (eq != std::string::npos) {
            std::string key = qs.substr(0, eq);
            if (key == "name") {
                name = qs.substr(eq + 1);
            }
        }
    }
    res.set_content("Hello " + name + "!", "text/plain");
    return;
}
```

Он считывает значение параметра `name` из строки запроса `/hello?name=Ivan` и подставляет его в ответ.  
