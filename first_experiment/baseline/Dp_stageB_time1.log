+# ---------------------------------------------------------------------
+#  Rename commands RNFR / RNTO (RFC3659)
+# ---------------------------------------------------------------------
+def do_RNFR(self, arg: str):
+    """Rename From: store source path for subsequent RNTO."""
+    if not self.logged_in:
+        self.send_reply(REPLY_530)
+        return
+    abs_path = self._resolve_path(arg)
+    # Path must point to existing file (not directory) within root
+    if not abs_path or not os.path.isfile(abs_path):
+        self.send_reply(REPLY_550)
+        return
+    # Store from path; the next command should be RNTO
+    self.rename_from_abs = abs_path
+    self.send_reply("350 Requested file exists. File ready for renaming.\r\n")
+
+def do_RNTO(self, arg: str):
+    """Rename To: perform rename using earlier RNFR path."""
+    if not self.logged_in:
+        self.send_reply(REPLY_530)
+        return
+    if not self.rename_from_abs:
+        # No prior RNFR; bad sequence
+        self.send_reply("503 Bad sequence of commands. RNTO without RNFR.\r\n")
+        return
+    # Resolve new path within root relative to current dir if not absolute
+    abs_new = self._resolve_path(arg)
+    if not abs_new:
+        # target outside root or invalid path
+        self.rename_from_abs = None
+        self.send_reply(REPLY_550)
+        return
+    # Ensure parent directory exists and is a directory within root
+    new_parent = os.path.dirname(abs_new)
+    if not os.path.isdir(new_parent):
+        self.rename_from_abs = None
+        self.send_reply("550 Directory does not exist for target.\r\n")
+        return
+    try:
+        # perform rename operation
+        os.rename(self.rename_from_abs, abs_new)
+    except Exception as e:
+        logging.error(f"Client {self.client_address}: rename failed: {e}")
+        self.rename_from_abs = None
+        self.send_reply(REPLY_550)
+        return
+    # Reset stored path after operation (success or failure handled above)
+    self.rename_from_abs = None
+    self.send_reply("250 File renamed successfully.\r\n")
+
 def do_RETR(self, arg: str):
     if not self.logged_in:
         self.send_reply(REPLY_530)
         return

