    def do_RNFR(self, arg: str):
        if not self.logged_in:
            self.send_reply(REPLY_530)
            return
        abs_path = self._resolve_path(arg)
        if not abs_path or not os.path.isfile(abs_path):
            self.send_reply("550 File not found.\r\n")
            return
        self.rename_src = abs_path
        self.send_reply("350 Requested file action pending further information.\r\n")

    def do_RNTO(self, arg: str):
        if not self.logged_in:
            self.send_reply(REPLY_530)
            return
        if self.rename_src is None:
            self.send_reply("503 Bad sequence of commands. No RNFR before RNTO.\r\n")
            return
        target_abs = self._resolve_path(arg)
        if not target_abs:
            self.send_reply("550 Requested action failed; destination outside allowed area.\r\n")
            return
        # ensure parent dir exists
        target_dir = os.path.dirname(target_abs)
        if not os.path.isdir(target_dir):
            try:
                os.makedirs(target_dir, exist_ok=True)
            except Exception as e:
                self.send_reply(f"550 Failed to create target directory: {e}\r\n")
                return
        try:
            os.rename(self.rename_src, target_abs)
            self.send_reply("250 File successfully renamed.\r\n")
        except Exception as e:
            self.send_reply(f"500 Rename failed: {e}\r\n")
        finally:
            self.rename_src = None
```

