    def do_RNFR(self, arg: str):
        if not self.logged_in:
            self.send_reply(REPLY_530)
            return
        target = self._resolve_path(arg)
        if not target or not os.path.exists(target) or not os.path.isfile(target):
            self.send_reply(REPLY_550)
            return
        self.rename_from = target
        self.send_reply("350 Requested file action pending further information.\r\n")

    def do_RNTO(self, arg: str):
        if not self.logged_in:
            self.send_reply(REPLY_530)
            return
        if not self.rename_from:
            self.send_reply("503 Bad sequence of commands.\r\n")
            return
        target = self._resolve_path(arg)
        if not target or os.path.isdir(target):
            # rename to directory path invalid - but we allow file? maybe reject if dir exists?
            # We'll just proceed if not None.
            pass  # no extra check
        try:
            os.rename(self.rename_from, target)
            self.send_reply("250 Requested file action okay, completed.\r\n")
        except Exception as e:
            logging.error(f"Client {self.client_address}: rename failed: {e}")
            self.send_reply(REPLY_550)
        finally:
            self.rename_from = None
```

