     def do_STOR(self, arg: str):
         self.send_reply(REPLY_202)
 
+    def do_RNFR(self, arg: str):
+        if not self.logged_in:
+            self.send_reply(REPLY_530)
+            return
+        abs_target = self._resolve_path(arg)
+        if not abs_target or not os.path.exists(abs_target):
+            # Path does not exist or out-of-root.
+            self.pending_rename_from = None
+            self.send_reply("550 Requested action not taken; file unavailable.\r\n")
+            return
+        # Store source for rename
+        self.pending_rename_from = abs_target
+        self.send_reply("350 File name okay, about to rename.\r\n")
+
+    def do_RNTO(self, arg: str):
+        if not self.logged_in:
+            self.send_reply(REPLY_530)
+            return
+        if not getattr(self, 'pending_rename_from', None):
+            self.send_reply("503 Bad sequence of commands.\r\n")
+            return
+        src = self.pending_rename_from
+        dst_abs = self._resolve_path(arg)
+        self.pending_rename_from = None  # clear regardless of result
+        if not dst_abs:
+            self.send_reply("550 Requested action not taken; file unavailable.\r\n")
+            return
+        try:
+            # Use os.replace to overwrite if exists
+            os.makedirs(os.path.dirname(dst_abs), exist_ok=True)
+            os.replace(src, dst_abs)
+            self.send_reply("250 File renamed successfully.\r\n")
+        except OSError as e:
+            logging.error(f"Client {self.client_address}: rename error: {e}")
+            self.send_reply("550 Requested action not taken; file unavailable.\r\n")
