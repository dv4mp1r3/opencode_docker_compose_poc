+// Helper function to parse query parameters
+std::map<std::string, std::string> parse_query_params(const std::string& query) {
+    std::map<std::string, std::string> params;
+    size_t pos = 0;
+    while (pos < query.length()) {
+        size_t ampersand = query.find('&', pos);
+        size_t equals = query.find('=', pos);
+        if (equals == std::string::npos || equals > ampersand) {
+            equals = ampersand;
+        }
+        if (equals != std::string::npos) {
+            std::string key = query.substr(pos, equals - pos);
+            std::string value = (ampersand != std::string::npos) ? 
+                query.substr(equals + 1, ampersand - equals - 1) : 
+                query.substr(equals + 1);
+            params[key] = value;
+        }
+        pos = (ampersand != std::string::npos) ? ampersand + 1 : query.length();
+    }
+    return params;
+}
 
